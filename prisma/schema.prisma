generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  password     String
  refreshToken String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  avatar       String?
  gender       String?
  name         String
  phone        String?
  roleId       String
  media        Media[]
  role         Role     @relation(fields: [roleId], references: [id])
}

model Group {
  id          String       @id @default(cuid(2))
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          String   @id @default(cuid(2))
  name        String   @unique
  description String?
  groupId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id])
  roles       Role[]   @relation("PermissionToRole")
}

model Role {
  id          String       @id @default(cuid(2))
  name        String       @unique
  description String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Media {
  id                 String         @id @default(cuid(2))
  fileName           String
  storedPath         String
  publicUrl          String
  mimeType           String
  type               String
  size               Int
  width              Int?
  height             Int?
  thumbnail          String?
  altText            String?
  title              String?
  uploadedById       String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  uploadedBy         User           @relation(fields: [uploadedById], references: [id])
  productAttachments ProductMedia[]
}

model Category {
  id          String     @id @default(cuid(2))
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]  @relation("CategoryToProduct")
}

model Brand {
  id          String    @id @default(cuid(2))
  name        String    @unique
  slug        String    @unique
  logo        String?
  status      Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Attribute {
  id        String           @id @default(cuid(2))
  name      String           @unique
  slug      String           @unique
  type      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]
}

model AttributeValue {
  id               String           @id @default(cuid(2))
  value            String
  slug             String
  referenceValue   String?
  attributeId      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  attribute        Attribute        @relation(fields: [attributeId], references: [id])
  mediaAttachments ProductMedia[]
  variants         ProductVariant[] @relation("AttributeValueToProductVariant")

  @@unique([attributeId, value])
}

model Product {
  id               String           @id @default(cuid(2))
  name             String
  slug             String           @unique
  sku              String?          @unique
  shortDescription String?
  longDescription  String?
  hasVariants      Boolean          @default(false)
  price            Float?
  salePrice        Float?
  stock            Int?
  stockStatus      String?
  weight           Float?
  active           Boolean          @default(true)
  featured         Boolean          @default(false)
  sortOrder        Int              @default(0)
  brandId          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  brand            Brand?           @relation(fields: [brandId], references: [id])
  mediaAttachments ProductMedia[]
  variants         ProductVariant[]
  categories       Category[]       @relation("CategoryToProduct")
}

model ProductVariant {
  id                String           @id @default(cuid(2))
  productId         String
  sku               String           @unique
  price             Float
  salePrice         Float?
  stock             Int
  stockStatus       String?
  lowStockThreshold Int?
  weight            Float?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  mediaAttachments  ProductMedia[]
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues   AttributeValue[] @relation("AttributeValueToProductVariant")
}

model ProductMedia {
  id               String          @id @default(cuid(2))
  mediaId          String
  productId        String?
  variantId        String?
  attributeValueId String?
  isThumbnail      Boolean         @default(false)
  isGallery        Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id])
  media            Media           @relation(fields: [mediaId], references: [id])
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}
